{
	"name": "pop-agent",
	"version": "0.1.0",
	"bin": {
		"pop-agent": "dist/server/cli.js",
		"pop": "dist/server/cli.js"
	},
	"files": [
		"dist",
		"web/dist",
		"helper/asr/main.swift",
		"helper/asr/Info.plist",
		"helper/asr/build.sh",
		"helper/asr/release/ASRBridge.zip"
	],
	"description": "PopAgent — 多 Agent 统一 Web 工作台，对 Pi Agent 深度适配，同时支持 Codex、Claude 等引擎；可打包成桌面 App",
	"author": "duzhenxun",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/duzhenxun/pop-agent.git"
	},
	"homepage": "https://github.com/duzhenxun/pop-agent#readme",
	"bugs": {
		"url": "https://github.com/duzhenxun/pop-agent/issues"
	},
	"keywords": [
		"popagent",
		"pop-agent",
		"coding-agent",
		"pi-agent",
		"pi-web",
		"codex-web",
		"opencode-web",
		"claude-code-web",
		"web-ui",
		"desktop-app"
	],
	"type": "module",
	"main": "dist/server/index.js",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0",
		"npm": ">=9"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:server": "node --import tsx --watch server/index.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"serve": "node --import tsx server/index.ts",
		"build": "npm run build:server && npm run build:web",
		"build:server": "tsc -p tsconfig.server.json",
		"build:web": "vite build --config web/vite.config.ts",
		"build:electron": "tsc -p electron/tsconfig.json",
		"app": "npm run build && npm run build:electron && npm run app:name && electron .",
		"app:dev": "npm run build:server && npm run build:electron && npm run app:name && electron .",
		"app:name": "node scripts/app-name.mjs",
		"app:dist": "npm run build && npm run build:electron && npm run build:helper && npm run runtime:fetch && npm run package:prepare && electron-builder",
		"start": "node dist/server/cli.js",
		"stop": "node dist/server/cli.js stop",
		"restart": "node dist/server/cli.js restart",
		"typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
		"lint": "oxlint server web/src scripts",
		"lint:fix": "oxlint --fix server web/src scripts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"icons": "node scripts/make-icons.mjs",
		"cues": "node scripts/make-voice-cues.mjs",
		"build:asr": "sh helper/asr/build.sh",
		"build:helper": "node scripts/build-helper.mjs",
		"asr:release": "sh helper/asr/build.sh --release",
		"runtime:fetch": "node scripts/fetch-node-runtime.mjs",
		"package:prepare": "node scripts/prepare-package.mjs",
		"prepack": "npm run build",
		"app:dist:thin": "npm run build && npm run build:electron && npm run build:helper && npm run package:prepare && electron-builder --config electron-builder.thin.yml"
	},
	"devDependencies": {
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/web-push": "^3.6.4",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-react": "^6.0.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"electron": "^33.4.11",
		"electron-builder": "^25.1.8",
		"highlight.js": "~11.11.0",
		"mermaid": "^12.2.0",
		"oxlint": "^1.0.0",
		"playwright-core": "^1.64.1",
		"prettier": "^3.4.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vite": "^8.0.0"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-mcp": "1.4.0",
		"express": "^5.3.0",
		"node-edge-tts": "1.2.12",
		"web-push": "^3.6.7",
		"ws": "^8.18.0"
	},
	"optionalDependencies": {
		"node-pty": "^1.1.0"
	},
	"allowScripts": [
		"electron",
		"electron-builder",
		"app-builder-bin",
		"esbuild",
		"node-pty"
	]
}
